+  private async runScheduledConnect(address: string, channel: number): Promise<void> {
+    if (this.desiredAddress !== address || this.desiredChannel !== channel) return;
+    if (this.rfcommClient.connected && this.rfcommClient.address === address) return;
+
+    const devices = await this.adapter.getDevices();
+    const aclConnected = devices.some(
+      (device) =>
+        device.address.toUpperCase() === address.toUpperCase() && device.connected,
+    );
+    if (!aclConnected) {
+      log.info(`Not reconnecting RFCOMM to ${address}; the Bluetooth ACL is disconnected`);
+      return;
+    }
+
+    try {
+      await this.connect(address, channel);
+    } catch (error) {
+      log.warn(`RFCOMM connection to ${address} channel ${channel} failed: ${error}`);
+      this.scheduleReconnect(address, channel);
+    }
+  }
