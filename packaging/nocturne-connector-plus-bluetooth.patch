+    const delayMs = Math.min(60_000, 2000 * 2 ** exponent) +
+      Math.floor(Math.random() * 500);
+    this.reconnectAttempt++;
+    this.scheduleAutoConnect(address, channel, delayMs, "RFCOMM reconnect");
+  }
