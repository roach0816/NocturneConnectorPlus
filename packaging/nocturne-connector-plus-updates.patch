--- /dev/null
+++ b/src/server/routes/connector-update.ts
@@ -0,0 +1,324 @@
+import { Elysia } from "elysia";
+import {
+  existsSync,
+  mkdirSync,
+  readFileSync,
+  renameSync,
+  writeFileSync,
+} from "fs";
+import { createLogger } from "../utils/logger";
+
+const PACKAGE_NAME = "nocturne-connector-plus";
+const UPDATE_HELPER =
+  "/usr/libexec/nocturne-connector-plus/install-connector-update";
+const UPDATE_LOCK = "/run/nocturne-connector-plus-update.lock";
+const PACKAGE_VERSION_PATH =
+  "/usr/libexec/nocturne-connector-plus/package-version";
+const STATUS_CACHE_PATH =
+  "/var/cache/nocturne-connector-plus/update-status.json";
+const STATUS_CACHE_TMP_PATH = `${STATUS_CACHE_PATH}.tmp`;
+const UPDATE_CHECK_INTERVAL_MS = 60 * 60 * 1000;
+const UPSTREAM_RELEASE_URL =
+  "https://api.github.com/repos/usenocturne/nocturne-connector/releases/latest";
+const PACKAGE_VERSIONS_URL =
+  "https://roach0816.github.io/NocturneConnectorPlus/apk/versions.json";
+
+const log = createLogger("ConnectorUpdate");
+
+interface PackageRecord {
+  name: string;
+  version: string;
+}
+
+interface PackageProvenance {
+  upstream?: { tag?: string };
+  package?: { name?: string; version?: string };
+}
+
+interface UpstreamRelease {
+  tag_name?: string;
+  draft?: boolean;
+  prerelease?: boolean;
+}
+
+interface UpdateStatus {
+  status: "up_to_date" | "update_available" | "package_pending";
+  currentVersion: string;
+  installedPackageVersion: string;
+  latestUpstreamVersion: string;
+  availablePackageVersion: string;
+  packagedUpstreamVersion: string | null;
+  updateAvailable: boolean;
+  packagePending: boolean;
+  installing: false;
+  checkedAt: string;
+}
+
+async function runCommand(command: string[]): Promise<string> {
+  const proc = Bun.spawn(command, { stdout: "pipe", stderr: "pipe" });
+  const [stdout, stderr, exitCode] = await Promise.all([
+    new Response(proc.stdout).text(),
+    new Response(proc.stderr).text(),
+    proc.exited,
+  ]);
+  if (exitCode !== 0) {
+    throw new Error(stderr.trim() || `${command[0]} exited with ${exitCode}`);
+  }
+  return stdout.trim();
+}
+
+function packageVersion(recordsJson: string): string | null {
+  const records = JSON.parse(recordsJson) as PackageRecord[];
+  return records.find((record) => record.name === PACKAGE_NAME)?.version ?? null;
+}
+
+async function fetchJson<T>(url: string): Promise<T> {
+  const response = await fetch(url, {
+    cache: "no-store",
+    headers: {
+      Accept: "application/vnd.github+json",
+      "User-Agent": "Nocturne-Connector-Plus",
+    },
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (!response.ok) {
+    throw new Error(`Update metadata request returned HTTP ${response.status}`);
+  }
+  return (await response.json()) as T;
+}
+
+function currentUpstreamVersion(): string {
+  try {
+    return readFileSync("/etc/nocturne-connector/version", "utf-8").trim();
+  } catch {
+    return "unknown";
+  }
+}
+
+function currentPackageVersion(): string {
+  try {
+    return readFileSync(PACKAGE_VERSION_PATH, "utf-8").trim();
+  } catch {
+    return "unknown";
+  }
+}
+
+function readCachedStatus(): UpdateStatus | null {
+  try {
+    return JSON.parse(readFileSync(STATUS_CACHE_PATH, "utf-8")) as UpdateStatus;
+  } catch {
+    return null;
+  }
+}
+
+function writeCachedStatus(status: UpdateStatus): void {
+  mkdirSync("/var/cache/nocturne-connector-plus", { recursive: true });
+  writeFileSync(STATUS_CACHE_TMP_PATH, `${JSON.stringify(status)}\n`, "utf-8");
+  renameSync(STATUS_CACHE_TMP_PATH, STATUS_CACHE_PATH);
+}
+
+function isSameOriginRequest(request: Request): boolean {
+  const origin = request.headers.get("origin");
+  if (!origin) return true;
+  const host = request.headers.get("host");
+  try {
+    return new URL(origin).host === host;
+  } catch {
+    return false;
+  }
+}
+
+async function checkForUpdates(): Promise<UpdateStatus> {
+  if (existsSync(UPDATE_LOCK)) {
+    throw new Error("A Connector update is currently being installed");
+  }
+
+  await runCommand(["apk", "update"]);
+
+  const [installedJson, availableJson, upstream, provenance] = await Promise.all([
+    runCommand([
+      "apk",
+      "query",
+      "--from",
+      "installed",
+      "--fields",
+      "name,version",
+      "--format",
+      "json",
+      PACKAGE_NAME,
+    ]),
+    runCommand([
+      "apk",
+      "query",
+      "--from",
+      "repositories",
+      "--fields",
+      "name,version",
+      "--format",
+      "json",
+      PACKAGE_NAME,
+    ]),
+    fetchJson<UpstreamRelease>(UPSTREAM_RELEASE_URL),
+    fetchJson<PackageProvenance[]>(PACKAGE_VERSIONS_URL),
+  ]);
+
+  const installedPackageVersion = packageVersion(installedJson);
+  const availablePackageVersion = packageVersion(availableJson);
+  const latestUpstreamVersion = upstream.tag_name ?? "unknown";
+  const currentVersion = currentUpstreamVersion();
+
+  if (
+    upstream.draft ||
+    upstream.prerelease ||
+    !/^v\d+\.\d+\.\d+(?:-\d+)?$/.test(latestUpstreamVersion)
+  ) {
+    throw new Error("Upstream returned an unsupported release version");
+  }
+  if (!installedPackageVersion || !availablePackageVersion) {
+    throw new Error("Could not determine installed and available package versions");
+  }
+
+  const comparison = await runCommand([
+    "apk",
+    "version",
+    "--test",
+    availablePackageVersion,
+    installedPackageVersion,
+  ]);
+  const availableProvenance = provenance.find(
+    (entry) =>
+      entry.package?.name === PACKAGE_NAME &&
+      entry.package?.version === availablePackageVersion,
+  );
+  const packagedUpstreamVersion = availableProvenance?.upstream?.tag ?? null;
+  const updateAvailable = comparison === ">";
+  const upstreamAhead = latestUpstreamVersion !== currentVersion;
+  const packagePending =
+    upstreamAhead && packagedUpstreamVersion !== latestUpstreamVersion;
+
+  const status: UpdateStatus = {
+    status: updateAvailable
+      ? ("update_available" as const)
+      : packagePending
+        ? ("package_pending" as const)
+        : ("up_to_date" as const),
+    currentVersion,
+    installedPackageVersion,
+    latestUpstreamVersion,
+    availablePackageVersion,
+    packagedUpstreamVersion,
+    updateAvailable,
+    packagePending,
+    installing: false,
+    checkedAt: new Date().toISOString(),
+  };
+  writeCachedStatus(status);
+  return status;
+}
+
+let statusCheck: ReturnType<typeof checkForUpdates> | null = null;
+
+function getCoalescedUpdateStatus(): Promise<UpdateStatus> {
+  if (!statusCheck) {
+    statusCheck = checkForUpdates().finally(() => {
+      statusCheck = null;
+    });
+  }
+  return statusCheck;
+}
+
+function getCachedUpdateStatus() {
+  const currentVersion = currentUpstreamVersion();
+  const installedPackageVersion = currentPackageVersion();
+  if (existsSync(UPDATE_LOCK)) {
+    return {
+      status: "installing" as const,
+      currentVersion,
+      installedPackageVersion,
+      updateAvailable: false,
+      packagePending: false,
+      installing: true,
+      checkedAt: new Date().toISOString(),
+    };
+  }
+
+  const cached = readCachedStatus();
+  if (cached && cached.installedPackageVersion === installedPackageVersion) {
+    return { ...cached, currentVersion, installedPackageVersion };
+  }
+
+  return {
+    status: "checking" as const,
+    currentVersion,
+    installedPackageVersion,
+    updateAvailable: false,
+    packagePending: false,
+    installing: false,
+    checkedAt: new Date(0).toISOString(),
+  };
+}
+
+function runBackgroundCheck(): void {
+  void getCoalescedUpdateStatus().catch((error) => {
+    log.warn(`Automatic update check failed: ${error}`);
+  });
+}
+
+runBackgroundCheck();
+const updateCheckTimer = setInterval(runBackgroundCheck, UPDATE_CHECK_INTERVAL_MS);
+updateCheckTimer.unref();
+
+export const connectorUpdateRoutes = new Elysia({
+  prefix: "/api/connector-update",
+})
+  .get("/status", ({ set }) => {
+    set.headers["cache-control"] = "no-store";
+    return getCachedUpdateStatus();
+  })
+  .post("/check", async ({ request, set }) => {
+    if (!isSameOriginRequest(request)) {
+      set.status = 403;
+      return { error: "Update checks must be started from the local web interface" };
+    }
+    set.headers["cache-control"] = "no-store";
+    return getCoalescedUpdateStatus();
+  })
+  .post("/install", async ({ request, set }) => {
+    if (!isSameOriginRequest(request)) {
+      set.status = 403;
+      return { error: "Connector updates must be started from the local web interface" };
+    }
+    if (existsSync(UPDATE_LOCK)) {
+      set.status = 409;
+      return { error: "A Connector update is already running" };
+    }
+
+    const status = getCachedUpdateStatus();
+    if (
+      !status.updateAvailable ||
+      !("availablePackageVersion" in status)
+    ) {
+      set.status = 409;
+      return { error: "No signed Connector package update is available" };
+    }
+    const targetPackageVersion = status.availablePackageVersion;
+    if (!existsSync(UPDATE_HELPER)) {
+      set.status = 500;
+      return { error: "The package update helper is not installed" };
+    }
+
+    try {
+      await runCommand([UPDATE_HELPER, "start"]);
+      log.info(
+        `Started package update from ${status.installedPackageVersion} to ${targetPackageVersion}`,
+      );
+      return {
+        status: "installing",
+        targetPackageVersion,
+      };
+    } catch (error) {
+      log.error(`Could not start package update: ${error}`);
+      set.status = 500;
+      return { error: "Could not start the Connector update" };
+    }
+  });
